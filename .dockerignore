# Build context exclusions for repo-root builds (the Go services).
#
# The Go images copy only go.mod, go.sum, packages/ and services/, but the
# context is still uploaded to the daemon before that, so anything large or
# secret is excluded here rather than trusted to the COPY lines.

# Dependencies and build output
node_modules
**/node_modules
.next
**/.next
dist
build
bin
out
**/*.tsbuildinfo

# VCS and local process state
.git
.github
.gitignore
.run

# Secrets. The private key mints access tokens for every tenant; it is mounted
# at runtime, never baked into an image.
deploy/keys
**/*.pem
**/*.key
.env
.env.*
!.env.example

# Go test and coverage artifacts
**/*.test
**/*.out
vendor

# Editors and OS
.DS_Store
.idea
.vscode
**/*.swp

# Local data, backups, and logs
deploy/data
uploads
backups
*.sql.gz
*.tar.gz
**/*.log

# Non-build directories
docs
scripts
