# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------
# Root domain. Subdomains are derived from it:
#   {HOSTNAME}              public landing page
#   root.{HOSTNAME}         platform administration
#   jobs.{HOSTNAME}         candidate job portal
#   {company-slug}.{HOST}   per-company careers portal
PLATFORM_HOSTNAME=karmarat.local
PLATFORM_ENV=development

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
POSTGRES_USER=karmarat
POSTGRES_PASSWORD=karmarat
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_PASSWORD=karmarat
REDIS_HOST=localhost
REDIS_PORT=6379

NATS_URL=nats://localhost:4222

# ---------------------------------------------------------------------------
# Object storage (S3-compatible; MinIO locally)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=karmarat
S3_SECRET_KEY=karmarat-secret
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# RS256 keypair used to sign access tokens. Generate with:
#   make keys
JWT_PRIVATE_KEY_PATH=./deploy/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./deploy/keys/jwt-public.pem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# ---------------------------------------------------------------------------
# Service ports
# ---------------------------------------------------------------------------
GATEWAY_HTTP_PORT=8080
IDENTITY_HTTP_PORT=8081
IDENTITY_GRPC_PORT=9081

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Payments (provider-agnostic; Stripe is the first implementation)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Service-to-service
# ---------------------------------------------------------------------------
# Shared secret guarding the internal endpoints services call on each other.
INTERNAL_SERVICE_TOKEN=

# ---------------------------------------------------------------------------
# Object storage buckets
#
# Created by the minio-init container on first start. Resumes are private and
# always served through short-lived presigned URLs; company assets are public
# because a careers portal renders them directly.
# ---------------------------------------------------------------------------
S3_BUCKET_RESUMES=resumes
S3_BUCKET_COMPANY_ASSETS=company-assets
S3_BUCKET_DOCUMENTS=documents
S3_PRESIGN_TTL=15m

# ---------------------------------------------------------------------------
# Outbound email
#
# Mailpit in development captures everything and delivers nothing, so a test
# run cannot email a real candidate.
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@karmarat.local
SMTP_FROM_NAME=Karmarat
SMTP_TLS=false

# ---------------------------------------------------------------------------
# Service discovery
#
# The gateway proxies to these. Defaults suit `make dev`; in a container
# network or a deployment, point each one at the real address. A service that
# is not built yet simply returns 502 when a route reaches it.
# ---------------------------------------------------------------------------
IDENTITY_URL=http://localhost:8081
COMPANIES_URL=http://localhost:8082
SUBSCRIPTIONS_URL=http://localhost:8083
PAYMENTS_URL=http://localhost:8084
JOBS_URL=http://localhost:8085
APPLICATIONS_URL=http://localhost:8086
CANDIDATES_URL=http://localhost:8087
MESSAGING_URL=http://localhost:8088
NOTIFICATIONS_URL=http://localhost:8089
SUPPORT_URL=http://localhost:8090
ADMIN_URL=http://localhost:8091
INTERVIEWS_URL=http://localhost:8092
OFFERS_URL=http://localhost:8093
AUDIT_URL=http://localhost:8094

# ---------------------------------------------------------------------------
# Gateway rate limiting
#
# Requests per window, per account when authenticated and per IP otherwise.
# ---------------------------------------------------------------------------
GATEWAY_RATE_LIMIT=300
GATEWAY_RATE_WINDOW=1m

# ---------------------------------------------------------------------------
# Connection overrides
#
# Leave these unset locally: they are derived from the POSTGRES_* and REDIS_*
# settings above. Set them directly when a managed provider hands you a URL.
# In production one of DATABASE_URL / POSTGRES_PASSWORD is required, and the
# service refuses to start without it.
# ---------------------------------------------------------------------------
# DATABASE_URL=
# REDIS_URL=

# ---------------------------------------------------------------------------
# Bootstrap (first run only; remove once the administrator has signed in)
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME="Platform Administrator"
BOOTSTRAP_ADMIN_PASSWORD=

# Signs the manual payment provider's webhooks. Required outside development;
# when empty in development the provider accepts unsigned callbacks and says so.
MANUAL_WEBHOOK_SECRET=
