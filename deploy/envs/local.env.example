# ==============================================================================
# Karmarat Environment Configuration: LOCAL (Development)
#
# Target Hostname: karmarat.local, *.karmarat.local
# Ingress / TLS:   Caddy self-signed local CA (internal)
# Email Delivery:  Mailpit (captured locally, nothing leaves the machine)
# Payment:         Stripe test mode or Manual mock provider
# ==============================================================================

PLATFORM_ENV=development
PLATFORM_HOSTNAME=karmarat.local
TLS_CONFIG=internal
ACME_EMAIL=admin@karmarat.local
LOG_LEVEL=debug

POSTGRES_USER=karmarat
POSTGRES_PASSWORD=karmarat
REDIS_PASSWORD=karmarat
INTERNAL_SERVICE_TOKEN=local-internal-dev-token-secret-32-chars

S3_ACCESS_KEY=karmarat
S3_SECRET_KEY=karmarat-secret
S3_REGION=us-east-1
S3_BUCKET_RESUMES=resumes
S3_BUCKET_COMPANY_ASSETS=company-assets
S3_BUCKET_DOCUMENTS=documents
S3_PRESIGN_TTL=15m

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Local dev admin bootstrap credentials
BOOTSTRAP_ADMIN_EMAIL=admin@karmarat.local
BOOTSTRAP_ADMIN_NAME="Platform Administrator"
BOOTSTRAP_ADMIN_PASSWORD=adminpassword

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_FROM_ADDRESS=no-reply@karmarat.local
SMTP_FROM_NAME="Karmarat Local"

COOKIE_SECURE=0
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
