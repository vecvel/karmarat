# ==============================================================================
# Karmarat Environment Configuration: UAT (User Acceptance Testing / Pre-Prod)
#
# Target Hostname: uat.karmarat.com, *.uat.karmarat.com
# Ingress / TLS:   Automated Let's Encrypt Wildcard via DNS-01 ACME
# Email Delivery:  Transactional email to internal QA/Stakeholder inboxes
# Payment:         Stripe Test Mode (sk_test_...) with full webhook verification
# ==============================================================================

PLATFORM_ENV=uat
PLATFORM_HOSTNAME=uat.karmarat.com

# In UAT, use internal for self-signed or DNS-01 for real wildcard certs:
# e.g., "dns cloudflare {env.CLOUDFLARE_API_TOKEN}"
TLS_CONFIG=internal
ACME_EMAIL=qa-uat@karmarat.com
LOG_LEVEL=info

POSTGRES_USER=karmarat
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-strong-random-password-uat
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=replace-with-a-strong-random-password-uat
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=replace-with-a-strong-random-token-uat

S3_ACCESS_KEY=karmarat
# Generate with: openssl rand -hex 32
S3_SECRET_KEY=replace-with-a-strong-random-secret-uat
S3_REGION=us-east-1
S3_BUCKET_RESUMES=resumes-uat
S3_BUCKET_COMPANY_ASSETS=company-assets-uat
S3_BUCKET_DOCUMENTS=documents-uat
S3_PRESIGN_TTL=15m

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

BOOTSTRAP_ADMIN_EMAIL=admin@uat.karmarat.com
BOOTSTRAP_ADMIN_NAME="UAT Administrator"
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-temporary-admin-password

# Transactional Email for QA & Pilot Users
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_uat_api_key_placeholder
SMTP_TLS=true
SMTP_FROM_ADDRESS=notifications@uat.karmarat.com
SMTP_FROM_NAME="Karmarat UAT"

COOKIE_SECURE=1
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_uat_placeholder
STRIPE_WEBHOOK_SECRET=whsec_uat_placeholder
