# ==============================================================================
# Karmarat Environment Configuration: PRODUCTION (Live Operations)
#
# Target Hostname: karmarat.com, *.karmarat.com
# Ingress / TLS:   Automated Let's Encrypt Wildcard via DNS-01 ACME
# Email Delivery:  Production Transactional Email (Resend / Postmark / SES)
# Payment:         Live Stripe (sk_live_...)
# ==============================================================================

PLATFORM_ENV=production
PLATFORM_HOSTNAME=karmarat.com

# Production TLS Configuration:
# Set to your DNS provider directive for automated Let's Encrypt wildcard certs:
# e.g., "dns cloudflare {env.CLOUDFLARE_API_TOKEN}"
TLS_CONFIG="dns cloudflare {env.CLOUDFLARE_API_TOKEN}"
ACME_EMAIL=admin@karmarat.com
LOG_LEVEL=warn

POSTGRES_USER=karmarat
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-strong-random-password-prod
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=replace-with-a-strong-random-password-prod
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=replace-with-a-strong-random-token-prod

S3_ACCESS_KEY=karmarat
# Generate with: openssl rand -hex 32
S3_SECRET_KEY=replace-with-a-strong-random-secret-prod
S3_REGION=us-east-1
S3_BUCKET_RESUMES=resumes
S3_BUCKET_COMPANY_ASSETS=company-assets
S3_BUCKET_DOCUMENTS=documents
S3_PRESIGN_TTL=15m

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Bootstrap Administrator (Set for first boot ONLY, then remove):
BOOTSTRAP_ADMIN_EMAIL=admin@karmarat.com
BOOTSTRAP_ADMIN_NAME="Platform Administrator"
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-temporary-admin-password

# Production Transactional Email
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_live_api_key_here
SMTP_TLS=true
SMTP_FROM_ADDRESS=notifications@karmarat.com
SMTP_FROM_NAME="Karmarat"

COOKIE_SECURE=1
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Offsite Disaster Recovery Backups
OFFSITE_S3_BUCKET=s3://karmarat-backups-production
RETENTION_DAYS=30
