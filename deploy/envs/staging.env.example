# ==============================================================================
# Karmarat Environment Configuration: STAGING (Integration & CI/CD)
#
# Target Hostname: staging.karmarat.com, *.staging.karmarat.com
# Ingress / TLS:   Automated Let's Encrypt Wildcard via DNS-01 ACME
# Email Delivery:  Sandbox SMTP (Mailtrap / Resend test domain)
# Payment:         Stripe Test Mode (sk_test_...)
# ==============================================================================

PLATFORM_ENV=staging
PLATFORM_HOSTNAME=staging.karmarat.com

# In staging, use internal for self-signed or DNS-01 for real wildcard certs:
# e.g., "dns cloudflare {env.CLOUDFLARE_API_TOKEN}"
TLS_CONFIG=internal
ACME_EMAIL=devops-staging@karmarat.com
LOG_LEVEL=info

POSTGRES_USER=karmarat
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-strong-random-password-staging
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=replace-with-a-strong-random-password-staging
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=replace-with-a-strong-random-token-staging

S3_ACCESS_KEY=karmarat
# Generate with: openssl rand -hex 32
S3_SECRET_KEY=replace-with-a-strong-random-secret-staging
S3_REGION=us-east-1
S3_BUCKET_RESUMES=resumes-staging
S3_BUCKET_COMPANY_ASSETS=company-assets-staging
S3_BUCKET_DOCUMENTS=documents-staging
S3_PRESIGN_TTL=15m

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

BOOTSTRAP_ADMIN_EMAIL=admin@staging.karmarat.com
BOOTSTRAP_ADMIN_NAME="Staging Administrator"
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-temporary-admin-password

# Staging Sandbox Email (e.g. Mailtrap or Resend)
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=api
SMTP_PASSWORD=mailtrap_api_key
SMTP_TLS=true
SMTP_FROM_ADDRESS=notifications@staging.karmarat.com
SMTP_FROM_NAME="Karmarat Staging"

COOKIE_SECURE=1
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_staging_placeholder
STRIPE_WEBHOOK_SECRET=whsec_staging_placeholder
