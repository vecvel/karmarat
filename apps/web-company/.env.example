# apps/web-company — a company's recruiting portal.
#
# There is deliberately no DATABASE_URL here. This app reads and writes nothing
# directly; every byte goes through the gateway, which is the only thing that
# verifies a token and resolves a tenant. A connection string in this file would
# be a second, unchecked way into a tenant's data.

# Where the gateway listens.
GATEWAY_URL=http://localhost:8080

# The platform's base hostname. A company portal lives at `{slug}.{this}`, and
# it must match PLATFORM_HOSTNAME in the repo-root .env — the gateway resolves
# the tenant from the Host header, so a mismatch does not fail loudly, it
# resolves a different tenant or none at all.
PLATFORM_HOSTNAME=karmarat.local

# The company this deployment serves.
#
# In production the slug is the first label of the hostname the request arrived
# on, which is what makes the tenant boundary a deployment fact rather than
# something a client can ask for. In development the app is usually reached as
# `localhost:3000`, which carries no slug, so this fills the gap.
#
# Leave it unset if you have `{slug}.karmarat.local` in /etc/hosts and browse
# by hostname.
COMPANY_SLUG=acme

# The Host header every server-side gateway call carries. Defaults to
# `{COMPANY_SLUG}.{PLATFORM_HOSTNAME}`, so it only needs setting when the portal
# answers on a hostname that is not derived from the slug.
# PORTAL_HOST=acme.karmarat.local

# Set to 1 to mark the refresh cookie Secure. Leave unset for plain-HTTP local
# development, where a Secure cookie would simply never be stored.
COOKIE_SECURE=

# Optional: the cookie's Domain. Left empty the cookie is host-only, which is
# what you want in development. In production set it to the portal hostname so
# the refresh token is scoped to this portal and no other.
COOKIE_DOMAIN=

# Branding shown before a session exists, on the sign-in screen.
NEXT_PUBLIC_APP_NAME="Karmarat"
NEXT_PUBLIC_ORG_NAME="My Organisation"
