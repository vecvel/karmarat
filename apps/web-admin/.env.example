# apps/web-admin — the platform administration console.
#
# There is no DATABASE_URL here and there must never be one. This console reads
# every tenant's state, which is exactly why it must do so through the gateway:
# the gateway is what checks that the caller is a platform principal on the root
# portal before a single row is read.

# Where the gateway listens. A connection address, not an identity.
GATEWAY_URL=http://localhost:8080

# The hostname the gateway must see. Platform routes exist only on the root
# portal, so a request that arrives as anything else is answered 404 — which is
# the boundary, not an inconvenience.
PORTAL_HOST=root.karmarat.local

# Set to 1 to mark the session cookies Secure. Leave unset for plain-HTTP local
# development, where a Secure cookie would simply never be stored.
COOKIE_SECURE=

# Optional: the cookie's Domain. Left empty the cookie is host-only, which is
# what you want in development, and what you want in production too — this
# console's session has no business being sent to a tenant's portal.
COOKIE_DOMAIN=
