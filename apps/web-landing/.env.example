# apps/web-landing — the public marketing site.
#
# There is no DATABASE_URL here and there must never be one. Every read and
# write this app performs goes through the gateway, which is the only thing
# that resolves a tenant or verifies a token.

# The gateway's origin. Server-side only — the browser never talks to it
# directly, because a browser cannot set the Host header the gateway routes on.
GATEWAY_URL=http://localhost:8080

# The hostname this portal answers on. Sent as the Host header on every gateway
# call, which is how the gateway knows this request belongs to the public
# portal. Must match PLATFORM_HOSTNAME in the repo-root .env.
PORTAL_HOST=karmarat.local

# http locally, https in production. Used to build links to the other portals.
PORTAL_SCHEME=http

# The other portals. In development each one is a separate Next server on its
# own port, so the hostname alone would not reach them; in production these can
# be left unset and are derived from PORTAL_SCHEME + PORTAL_HOST.
JOBS_PORTAL_URL=http://jobs.karmarat.local:3001
ROOT_PORTAL_URL=http://root.karmarat.local:3002
